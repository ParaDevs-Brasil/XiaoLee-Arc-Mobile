# ─── Privy (login social + carteira embutida) ────────────────────────────────
# Crie o app em https://dashboard.privy.io e cole appId/clientId aqui.
EXPO_PUBLIC_PRIVY_APP_ID=
EXPO_PUBLIC_PRIVY_CLIENT_ID=

# ─── Backend XiaoLee ──────────────────────────────────────────────────────────
# Deixe VAZIO em desenvolvimento: o app deriva o host do próprio Metro
# (ver mobile/src/lib/config.ts), o que já funciona em emulador e em aparelho
# físico na mesma rede. Preencha só para apontar para staging/produção.
#
# ATENÇÃO: variáveis EXPO_PUBLIC_* são embutidas no bundle em build time e
# ficam legíveis por qualquer um que baixar o app. Nunca coloque segredo aqui.
EXPO_PUBLIC_API_URL=
